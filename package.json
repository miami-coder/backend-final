{
  "name": "piyachok-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter backend-final migration:run",
    "seed:demo": "pnpm --filter backend-final seed:demo",
    "seed:superadmin": "pnpm --filter backend-final seed:superadmin"
  }
}
