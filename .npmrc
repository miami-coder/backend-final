# На Vercel (@vercel/node) трейсинг файлів лямбди не знаходить pg крізь
# symlink-верстку pnpm (.pnpm/...) — TypeORM робить динамічний require('pg')
# і в лямбді падає DriverPackageNotInstalledError → FUNCTION_INVOCATION_FAILED.
# node-linker=hoisted робить node_modules плоскою (як у npm), без симлінків.
node-linker=hoisted